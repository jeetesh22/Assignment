PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/assignment
# Generate a unique random value of at least 32 characters before starting the API.
JWT_SECRET=
# Backend-only OpenAI API key. Never expose it through frontend environment variables.
OPENAI_API_KEY=
# PostgreSQL with pgvector; run npm run db:migrate before processing/search.
POSTGRES_URL=
POSTGRES_DB=assignment
POSTGRES_USER=assignment
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Optional one-time initial admin account seed settings.
# If BOOTSTRAP_ADMIN_PASSWORD is empty, npm run seed:admin generates a password once.
BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com
BOOTSTRAP_ADMIN_NAME=Kriscent Admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345678
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DOCUMENT_STORAGE_DIR=.data/documents
